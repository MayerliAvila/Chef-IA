# ====================================================================
# Gitignore para el backend (Python / FastAPI)
# ====================================================================

# --- Archivos de configuración locales y secretos ---
.env
.env.*
!.env.example

# --- Entornos virtuales de Python ---
venv/
.venv/
env/
ENV/
ActiveState.venv/

# --- Bytecode de Python y caché ---
__pycache__/
*.pyc
*.pyo
*.pyd
.pytest_cache/
.mypy_cache/
.ruff_cache/

# --- Configuración de Editores y Herramientas ---
.vscode/
.idea/
.qodo/
*.swp
*.swo

# --- Distribuciones y paquetes ---
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
manifest
spec
